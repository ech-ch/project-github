# Kopiere diese Datei nach .env (gitignored) und fülle die echten Werte ein.
# Laden in die Shell: set -a; source .env; set +a
#
# Beide Variablen sind für die Pipeline obligatorisch:
#   - NEO4J_PASSWORD wird beim docker-compose-Start UND vom Python-Driver gelesen
#   - ANTHROPIC_API_KEY wird vom Notebook in Phase 3 gelesen

# Phase 2 — Neo4j-Passwort
# Beim ersten docker-compose up wird dieses Passwort gesetzt.
# Wichtig: Neo4j lehnt das Default-Passwort "neo4j" ab — wähle etwas anderes.
NEO4J_PASSWORD=changeme_pick_a_password

# Phase 3 — Anthropic API Key
# Holen unter https://console.anthropic.com → Settings → API Keys → Create Key
# Format: sk-ant-api03-... (etwa 100 Zeichen lang)
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Optional: Neo4j-Verbindungsdaten (Defaults sind ok für lokales Docker-Compose-Setup)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
